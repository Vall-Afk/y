# Rename this file to .env and set your real owner number; never commit .env
OWNER_NUMBER=6287721373781
BOT_NAME=Beauté.
OWNER_NAME=Vall
OWNER_INSTAGRAM=v4lonenonly
PREFIX=!
# Optional: same-phone login via WhatsApp linked-device pairing code; digits only, e.g. 6281234567890
# PAIRING_NUMBER=
DATA_DIR=./data
AUTH_DIR=./data/auth
PORT=3000
LOG_LEVEL=info

# Optional: require an active manually-managed rental for group commands
REQUIRE_SEWA=false

# Optional official YouTube Data API v3 key for ytsearch/play metadata (no downloader)
YOUTUBE_API_KEY=

# Optional: path to installed yt-dlp binary (standalone, NOT installed by npm)
# YTDLP_PATH=C:\\Tools\\yt-dlp.exe

# Optional SaveAPI integration. Keep your real key in local .env only.
SAVEAPI_KEY=
SAVEAPI_CDN_HOSTS=v16m.tiktokcdn-us.com,scontent.cdninstagram.com,video.twimg.com,v1.pinimg.com

# Optional AI providers. Core bot works without these credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional fact search. DuckDuckGo Instant Answer is used as a limited fallback.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional voice transcription: OpenAI-compatible transcription endpoint OR local whisper.cpp.
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# WHISPER_CPP_PATH=C:\\Tools\\whisper.cpp\\whisper-cli.exe
# WHISPER_MODEL_PATH=C:\\Models\\ggml-small.bin
# FFMPEG_PATH=C:\\Tools\\ffmpeg.exe

# Optional text-to-speech (OpenAI-compatible endpoint).
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Optional image generation: A1111 /sdapi/v1/txt2img or OpenAI-compatible image endpoint.
IMAGE_GEN_API_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-1

# Optional GitHub issue publishing. Token needs Issues: write on this repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=Vall-Afk/y

# Optional: use Gemini/Ollama as a context classifier; false uses the local conservative keyword rules.
TOXIC_AI_ENABLED=false

# Required before public dashboard access. Generate locally with: npm run dashboard:setup
# The setup script writes a scrypt password hash and random session secret into .env.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
